    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.optimize import fsolve\n",
    "\n",
    "# === SYSTEM EQUILIBRIUM CONSTANTS ===\n",
    "# These equilibrium constants were derived from literature (Kolah et al 2007) and describe \n",
    "# the sequential esterification steps of citric acid with ethanol.\n",
    "K1 = 6.35   # Step 1: CA + EtOH ⇌ ME + H₂O\n",
    "K2 = 2.72   # Step 2: ME + EtOH ⇌ DE + H₂O\n",
    "K3 = 3.78   # Step 3: DE + EtOH ⇌ TE + H₂O\n",
    "\n",
    "# === CORE MODEL FUNCTION: Equilibrium System Based on Extents of reaction Approach ===\n",
    "def equilibrium_model(xi, CA0, EtOH0):\n",
    "    \"\"\"\n",
    "    Defines the chemical equilibrium model using the extent of reactions ξ₁, ξ₂, ξ₃.\n",
    "    Each extent represents how much each reaction has progressed at equilibrium.\n",
    "    \"\"\"\n",
    "    xi1, xi2, xi3 = xi  # Reaction extent variables for steps 1, 2, and 3\n",
    "\n",
    "    # Calculate species concentrations at equilibrium using extent variables\n",
    "    # Assuming a constant volume system: \n",
    "    # therefore, the extent of the reaction is directly determined as a function of the concentration \n",
    "    CA = CA0 - xi1                      # Remaining Citric Acid\n",
    "    EtOH = EtOH0 - (xi1 + xi2 + xi3)     # Remaining Ethanol\n",
    "    ME = xi1 - xi2                      # Monoethyl Citrate\n",
    "    DE = xi2 - xi3                      # Diethyl Citrate\n",
    "    TE = xi3                            # Triethyl Citrate (desired product)\n",
    "    H2O = xi1 + xi2 + xi3                # Water formed cumulatively\n",
    "\n",
    "    # Law of Mass-action for reversible reactions (should approach zero when at true equilibrium)\n",
    "    eq1 = (ME * H2O) - K1 * (CA * EtOH)\n",
    "    eq2 = (DE * H2O) - K2 * (ME * EtOH)\n",
    "    eq3 = (TE * H2O) - K3 * (DE * EtOH)\n",
    "\n",
    "    return [eq1, eq2, eq3]\n",
    "\n",
    "# === INPUT RANGES FOR PARAMETRIC STUDY ===\n",
    "# These ranges systematically explore how varying starting material concentrations \n",
    "# affect triester (TE) equilibrium concentartion.\n",
    "EtOH0_range = np.linspace(3, 20, 10)     # Ethanol concentration sweep: 3 to 20 mol/L\n",
    "CA0_range = np.linspace(1, 3.5, 10)       # Citric acid concentration sweep: 1 to 3.5 mol/L\n",
    "\n",
    "# Selected fixed points for comparative plotting:\n",
    "fixed_CA0_values = [1.5, 2.0, 2.5]        # Fixed CA₀ for EtOH₀ sweeps\n",
    "fixed_EtOH0_values = [6.0, 10.0, 15.0]    # Fixed EtOH₀ for CA₀ sweeps\n",
    "\n",
    "# === MASS BALANCE VALIDATION + EQUILIBRIUM CONCENTRATION TABLE PRINT ===\n",
    "print(\"\\n======== EQUILIBRIUM TE CONCENTRATIONS AND MASS BALANCE VALIDATION =====\\n\")\n",
    "\n",
    "# Sweep at fixed EtOH₀ while varying CA₀\n",
    "for EtOH0 in fixed_EtOH0_values:\n",
    "    print(f\"\\n--- Fixed Initial Ethanol₀ = {EtOH0:.2f} mol/L ---\")\n",
    "    print(f\"{'CA₀ (mol/L)':<12}{'TE (mol/L)':<15}{'Mass Balance (Final/Initial Total)'}\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "    for CA0 in CA0_range:\n",
    "        #An informed initial guess improves solver robustness for nonlinear systems\n",
    "        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]\n",
    "        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))\n",
    "        xi1, xi2, xi3 = xi\n",
    "\n",
    "        # Reconstruct species concentrations\n",
    "        CA = CA0 - xi1\n",
    "        EtOH = EtOH0 - (xi1 + xi2 + xi3)\n",
    "        ME = xi1 - xi2\n",
    "        DE = xi2 - xi3\n",
    "        TE = xi3\n",
    "        H2O = xi1 + xi2 + xi3\n",
    "\n",
    "        # Full mass balance validation (include CA, ME, DE, TE, EtOH, H₂O)\n",
    "        # Perform mass balance validation for each case:\n",
    "        # Sum of [CA + ME + DE + TE + H2O] must equal initial concentrations\n",
    "        Initial_total = CA0 + EtOH0\n",
    "        Final_total = CA + ME + DE + TE + EtOH + H2O\n",
    "\n",
    "        mass_balance = f\"{Final_total:.4f} ≈ {Initial_total:.4f}\"\n",
    "\n",
    "        print(f\"{CA0:<12.2f}{TE:<15.4f}{mass_balance}\")\n",
    "\n",
    "# Sweep at fixed CA₀ while varying EtOH₀\n",
    "for CA0 in fixed_CA0_values:\n",
    "    print(f\"\\n--- Fixed Initial Citric Acid₀ = {CA0:.2f} mol/L ---\")\n",
    "    print(f\"{'EtOH₀ (mol/L)':<12}{'TE (mol/L)':<15}{'Mass Balance'}\")\n",
    "    print(\"-\" * 60)\n",
    "\n",
    "    for EtOH0 in EtOH0_range:\n",
    "        # Solve using initial guesses proportional to CA₀\n",
    "        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]\n",
    "        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))\n",
    "        xi1, xi2, xi3 = xi\n",
    "\n",
    "        # Reconstruct species concentrations\n",
    "        CA = CA0 - xi1\n",
    "        EtOH = EtOH0 - (xi1 + xi2 + xi3)\n",
    "        ME = xi1 - xi2\n",
    "        DE = xi2 - xi3\n",
    "        TE = xi3\n",
    "        H2O = xi1 + xi2 + xi3\n",
    "\n",
    "        # Full mass balance validation (include CA, ME, DE, TE, EtOH, H₂O)\n",
    "        # Difference between initial and final gives zero (0)\n",
    "        Initial_total = CA0 + EtOH0\n",
    "        Final_total = CA + ME + DE + TE + EtOH + H2O\n",
    "\n",
    "        mass_balance = f\"{Final_total:.4f} ≈ {Initial_total:.4f}\"\n",
    "\n",
    "        print(f\"{EtOH0:<12.2f}{TE:<15.4f}{mass_balance}\")\n",
    "\n",
    "print(\"\\n✅ TE concentration tables generated. Full mass conservation validated for all cases.\\n\")\n",
    "\n",
    "# === SIDE-BY-SIDE SWEEP PLOTS FOR PROCESS INSIGHTS ===\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n",
    "\n",
    "# --- Sweep 1: [TE] vs EtOH₀ at Different CA₀ (left plot)\n",
    "for CA0 in fixed_CA0_values:\n",
    "    TE_curve = []\n",
    "    for EtOH0 in EtOH0_range:\n",
    "        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]\n",
    "        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))\n",
    "        TE_curve.append(xi[2])\n",
    "\n",
    "    axes[0].plot(EtOH0_range, TE_curve, marker='o', linestyle='-', linewidth=2,\n",
    "                 label=f'CA₀ = {CA0:.1f} mol/L')\n",
    "\n",
    "axes[0].set_xlabel('Initial Ethanol Concentration (mol/L)', fontsize=12)\n",
    "axes[0].set_ylabel('Equilibrium Triethyl Citrate [TE] (mol/L)', fontsize=12)\n",
    "axes[0].set_title('Effect of EtOH₀ on [TE] at Fixed CA₀', fontsize=14)\n",
    "axes[0].grid(True, linestyle='--', alpha=0.7)\n",
    "axes[0].legend(title='Fixed CA₀ (mol/L)', fontsize=10)\n",
    "\n",
    "# --- Sweep 2: [TE] vs CA₀ at Different EtOH₀ (right plot)\n",
    "for EtOH0 in fixed_EtOH0_values:\n",
    "    TE_curve = []\n",
    "    for CA0 in CA0_range:\n",
    "        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]\n",
    "        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))\n",
    "        TE_curve.append(xi[2])\n",
    "\n",
    "    axes[1].plot(CA0_range, TE_curve, marker='s', linestyle='--', linewidth=2,\n",
    "                 label=f'EtOH₀ = {EtOH0:.1f} mol/L')\n",
    "\n",
    "axes[1].set_xlabel('Initial Citric Acid Concentration (mol/L)', fontsize=12)\n",
    "axes[1].set_ylabel('Equilibrium Triethyl Citrate [TE] (mol/L)', fontsize=12)\n",
    "axes[1].set_title('Effect of CA₀ on [TE] at Fixed EtOH₀', fontsize=14)\n",
    "axes[1].grid(True, linestyle='--', alpha=0.7)\n",
    "axes[1].legend(title='Fixed EtOH₀ (mol/L)', fontsize=10)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
