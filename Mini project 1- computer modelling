import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import fsolve

# === SYSTEM EQUILIBRIUM CONSTANTS ===
# These equilibrium constants were derived from literature (Kolah et al 2007) and describe 
# the sequential esterification steps of citric acid with ethanol.
K1 = 6.35   # Step 1: CA + EtOH ⇌ ME + H₂O
K2 = 2.72   # Step 2: ME + EtOH ⇌ DE + H₂O
K3 = 3.78   # Step 3: DE + EtOH ⇌ TE + H₂O

# === CORE MODEL FUNCTION: Equilibrium System Based on Extents of reaction Approach ===
def equilibrium_model(xi, CA0, EtOH0):
    """
    Defines the chemical equilibrium model using the extent of reactions ξ₁, ξ₂, ξ₃.
    Each extent represents how much each reaction has progressed at equilibrium.
    """
    xi1, xi2, xi3 = xi  # Reaction extent variables for steps 1, 2, and 3

    # Calculate species concentrations at equilibrium using extent variables
    # Assuming a constant volume system: 
    # therefore, the extent of the reaction is directly determined as a function of the concentration 
    CA = CA0 - xi1                      # Remaining Citric Acid
    EtOH = EtOH0 - (xi1 + xi2 + xi3)     # Remaining Ethanol
    ME = xi1 - xi2                      # Monoethyl Citrate
    DE = xi2 - xi3                      # Diethyl Citrate
    TE = xi3                            # Triethyl Citrate (desired product)
    H2O = xi1 + xi2 + xi3                # Water formed cumulatively

    # Law of Mass-action for reversible reactions (should approach zero when at true equilibrium)
    eq1 = (ME * H2O) - K1 * (CA * EtOH)
    eq2 = (DE * H2O) - K2 * (ME * EtOH)
    eq3 = (TE * H2O) - K3 * (DE * EtOH)

    return [eq1, eq2, eq3]

# === INPUT RANGES FOR PARAMETRIC STUDY ===
# These ranges systematically explore how varying starting material concentrations 
# affect triester (TE) equilibrium concentartion.
EtOH0_range = np.linspace(3, 20, 10)     # Ethanol concentration sweep: 3 to 20 mol/L
CA0_range = np.linspace(1, 3.5, 10)       # Citric acid concentration sweep: 1 to 3.5 mol/L

# Selected fixed points for comparative plotting:
fixed_CA0_values = [1.5, 2.0, 2.5]        # Fixed CA₀ for EtOH₀ sweeps
fixed_EtOH0_values = [6.0, 10.0, 15.0]    # Fixed EtOH₀ for CA₀ sweeps

# === MASS BALANCE VALIDATION + EQUILIBRIUM CONCENTRATION TABLE PRINT ===
print("\n======== EQUILIBRIUM TE CONCENTRATIONS AND MASS BALANCE VALIDATION =====\n")

# Sweep at fixed EtOH₀ while varying CA₀
for EtOH0 in fixed_EtOH0_values:
    print(f"\n--- Fixed Initial Ethanol₀ = {EtOH0:.2f} mol/L ---")
    print(f"{'CA₀ (mol/L)':<12}{'TE (mol/L)':<15}{'Mass Balance (Final/Initial Total)'}")
    print("-" * 60)

    for CA0 in CA0_range:
        #An informed initial guess improves solver robustness for nonlinear systems
        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]
        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))
        xi1, xi2, xi3 = xi

        # Reconstruct species concentrations
        CA = CA0 - xi1
        EtOH = EtOH0 - (xi1 + xi2 + xi3)
        ME = xi1 - xi2
        DE = xi2 - xi3
        TE = xi3
        H2O = xi1 + xi2 + xi3

        # Full mass balance validation (include CA, ME, DE, TE, EtOH, H₂O)
        # Perform mass balance validation for each case:
        # Sum of [CA + ME + DE + TE + H2O] must equal initial concentrations
        Initial_total = CA0 + EtOH0
        Final_total = CA + ME + DE + TE + EtOH + H2O

        mass_balance = f"{Final_total:.4f} ≈ {Initial_total:.4f}"

        print(f"{CA0:<12.2f}{TE:<15.4f}{mass_balance}")

# Sweep at fixed CA₀ while varying EtOH₀
for CA0 in fixed_CA0_values:
    print(f"\n--- Fixed Initial Citric Acid₀ = {CA0:.2f} mol/L ---")
    print(f"{'EtOH₀ (mol/L)':<12}{'TE (mol/L)':<15}{'Mass Balance'}")
    print("-" * 60)

    for EtOH0 in EtOH0_range:
        # Solve using initial guesses proportional to CA₀
        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]
        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))
        xi1, xi2, xi3 = xi

        # Reconstruct species concentrations
        CA = CA0 - xi1
        EtOH = EtOH0 - (xi1 + xi2 + xi3)
        ME = xi1 - xi2
        DE = xi2 - xi3
        TE = xi3
        H2O = xi1 + xi2 + xi3

        # Full mass balance validation (include CA, ME, DE, TE, EtOH, H₂O)
        # Difference between initial and final gives zero (0)
        Initial_total = CA0 + EtOH0
        Final_total = CA + ME + DE + TE + EtOH + H2O

        mass_balance = f"{Final_total:.4f} ≈ {Initial_total:.4f}"

        print(f"{EtOH0:<12.2f}{TE:<15.4f}{mass_balance}")

print("\n✅ TE concentration tables generated. Full mass conservation validated for all cases.\n")

# === SIDE-BY-SIDE SWEEP PLOTS FOR PROCESS INSIGHTS ===
fig, axes = plt.subplots(1, 2, figsize=(16, 6))

# --- Sweep 1: [TE] vs EtOH₀ at Different CA₀ (left plot)
for CA0 in fixed_CA0_values:
    TE_curve = []
    for EtOH0 in EtOH0_range:
        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]
        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))
        TE_curve.append(xi[2])

    axes[0].plot(EtOH0_range, TE_curve, marker='o', linestyle='-', linewidth=2,
                 label=f'CA₀ = {CA0:.1f} mol/L')

axes[0].set_xlabel('Initial Ethanol Concentration (mol/L)', fontsize=12)
axes[0].set_ylabel('Equilibrium Triethyl Citrate [TE] (mol/L)', fontsize=12)
axes[0].set_title('Effect of EtOH₀ on [TE] at Fixed CA₀', fontsize=14)
axes[0].grid(True, linestyle='--', alpha=0.7)
axes[0].legend(title='Fixed CA₀ (mol/L)', fontsize=10)

# --- Sweep 2: [TE] vs CA₀ at Different EtOH₀ (right plot)
for EtOH0 in fixed_EtOH0_values:
    TE_curve = []
    for CA0 in CA0_range:
        guess = [0.5 * CA0, 0.3 * CA0, 0.1 * CA0]
        xi = fsolve(equilibrium_model, guess, args=(CA0, EtOH0))
        TE_curve.append(xi[2])

    axes[1].plot(CA0_range, TE_curve, marker='s', linestyle='--', linewidth=2,
                 label=f'EtOH₀ = {EtOH0:.1f} mol/L')

axes[1].set_xlabel('Initial Citric Acid Concentration (mol/L)', fontsize=12)
axes[1].set_ylabel('Equilibrium Triethyl Citrate [TE] (mol/L)', fontsize=12)
axes[1].set_title('Effect of CA₀ on [TE] at Fixed EtOH₀', fontsize=14)
axes[1].grid(True, linestyle='--', alpha=0.7)
axes[1].legend(title='Fixed EtOH₀ (mol/L)', fontsize=10)

plt.tight_layout()
plt.show()

