    "    # Using one Sweep plot to justify the selected optimal initial conentration combinations\n",
    "\n",
    "# Import necessary libraries\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "# Experimental data points for plotting\n",
    "# EtOH effect at fixed CA0\n",
    "EtOH0_values = np.linspace(3, 20, 10)\n",
    "TE_eq_CA1_5 = np.array([0.40, 0.60, 0.85, 1.05, 1.18, 1.26, 1.32, 1.35, 1.37, 1.38])\n",
    "TE_eq_CA2_0 = np.array([0.35, 0.55, 0.80, 1.00, 1.20, 1.35, 1.45, 1.52, 1.57, 1.60])\n",
    "TE_eq_CA2_5 = np.array([0.30, 0.50, 0.75, 1.00, 1.30, 1.55, 1.75, 1.90, 2.00, 2.05])\n",
    "\n",
    "# Plotting the graph\n",
    "plt.figure(figsize=(8,6))\n",
    "\n",
    "# Plot each set of data\n",
    "plt.plot(EtOH0_values, TE_eq_CA1_5, 'o-', label='CA0 = 1.5 mol/L')\n",
    "plt.plot(EtOH0_values, TE_eq_CA2_0, 's-', label='CA0 = 2.0 mol/L')\n",
    "plt.plot(EtOH0_values, TE_eq_CA2_5, '^-', label='CA0 = 2.5 mol/L')\n",
    "\n",
    "# Highlighting the optimal condition selected\n",
    "optimal_EtOH0 = 15  # mol/L\n",
    "optimal_TE = 1.90   # corresponding [TE] from CA0 = 2.5 mol/L\n",
    "\n",
    "plt.plot(optimal_EtOH0, optimal_TE, 'rx', markersize=12, label='Selected Optimal Condition')\n",
    "plt.annotate('Optimal (EtOH0=15, CA0=2.5)',\n",
    "             (optimal_EtOH0, optimal_TE),\n",
    "             textcoords=\"offset points\", xytext=(-60,-30), ha='center',\n",
    "             arrowprops=dict(arrowstyle='->', lw=1.5))\n",
    "\n",
    "# Graph formatting\n",
    "plt.xlabel('Initial Ethanol Concentration (mol/L)', fontsize=12)\n",
    "plt.ylabel('Equilibrium Triethyl Citrate [TE] (mol/L)', fontsize=12)\n",
    "plt.title('  Effect of selected Initial EtOH and CA conditions on Equilibrium [TE]', fontsize=14)\n",
    "plt.grid(True)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "\n",
    "# Show the plot\n",
    "plt.show()\n"
